# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Public (safe to expose to the browser) ---
# Supabase project URL and anon key, from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never sent to the browser) ---
# Service-role key, used only in trusted server-side code (e.g. founder
# provisioning, admin actions). Full-access key: keep it out of client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App base URL, used for auth redirects. REQUIRED (https) when VERCEL_ENV=production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Deployment safety guard (set in EVERY Vercel environment) ---
# The 20-character ref of the VERIFIED production Supabase project. Production
# refuses to start until this is set and matches NEXT_PUBLIC_SUPABASE_URL;
# preview/development refuse to start if their URL points at this project.
# Leave empty locally until the production project has been verified.
PRODUCTION_SUPABASE_PROJECT_REF=
