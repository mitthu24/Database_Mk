# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Public (safe to expose to the browser) ---
# Supabase project URL and anon key, from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never sent to the browser) ---
# Service-role key, used only in trusted server-side code (e.g. founder
# provisioning, admin actions). Full-access key: keep it out of client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App base URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
